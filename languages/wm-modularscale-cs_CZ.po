#: src/Gutenberg/Blocks/theme-json-exporter/block.json
msgctxt "block title"
msgid "Theme.json Exporter (WM Scale)"
msgstr "Exportér Theme.json (WM Scale)"

#: src/Gutenberg/Blocks/theme-json-exporter/block.json
msgctxt "block description"
msgid ""
"Shows the theme.json fontSizes and the Tailwind CSS v4 @theme block "
"generated from the stored scale."
msgstr ""
"Zobrazuje fontSizes pro theme.json a blok @theme pro Tailwind CSS v4 "
"vygenerované z uložené škály."

