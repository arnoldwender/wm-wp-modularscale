msgctxt "block title"
msgid "APCA Contrast Badge (WM Scale)"
msgstr "Štítek kontrastu APCA (WM Scale)"

#: src/Gutenberg/Blocks/contrast-matrix-badge/block.json
msgctxt "block description"
msgid ""
"Badge with the APCA lightness contrast (Lc) of a text and background colour "
"pair and a usage hint for that value."
msgstr ""
"Štítek se světlostním kontrastem APCA (Lc) dvojice barev textu a pozadí a "
"doporučením použití."

