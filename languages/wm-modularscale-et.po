#: src/Gutenberg/Blocks/ratio-visualizer/block.json
msgctxt "block title"
msgid "Ratio Visualizer (SVG Curve)"
msgstr "Suhte visualiseerija (SVG-kõver)"

#: src/Gutenberg/Blocks/ratio-visualizer/block.json
msgctxt "block description"
msgid ""
"Shows the nine scale steps with their minimum and maximum size in px, "
"calculated from the stored base sizes and ratio."
msgstr ""
"Näitab skaala üheksat astet minimaalse ja maksimaalse px-suurusega "
"salvestatud väärtuste põhjal."

