#: src/Gutenberg/Blocks/typographic-grid/block.json
msgctxt "block description"
msgid ""
"Grid of 1–6 equal columns for inner blocks, with a gap from the scale "
"(default var(--wm-step-2))."
msgstr "1–6 võrdse veeruga võrgustik siseplokkidele skaalapõhise vahega."

