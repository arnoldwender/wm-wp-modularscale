#: src/Gutenberg/Blocks/typographic-grid/block.json
msgctxt "block title"
msgid "Typographic Grid (WM Scale)"
msgstr "Tipografska mreža (WM Scale)"

#: src/Gutenberg/Blocks/typographic-grid/block.json
msgctxt "block description"
msgid ""
"Grid of 1–6 equal columns for inner blocks, with a gap from the scale "
"(default var(--wm-step-2))."
msgstr ""
"Mreža z 1 do 6 enakimi stolpci za notranje bloke in razmikom iz lestvice."

