#: src/Integration/Ecosystem_Bridge.php:133
msgid "WM Modular Scale Token"
msgstr "Žeton WM Modular Scale"

#: src/Integration/Ecosystem_Bridge.php:137
msgid ""
"Outputs a computed fluid clamp() token or px range from WM Modular Scale."
msgstr ""
"Vrne izračunan tekoči clamp() žeton ali razpon v px iz WM Modular Scale."

