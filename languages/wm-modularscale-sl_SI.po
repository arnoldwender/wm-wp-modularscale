msgid "https://arnoldwender.com/wordpress-plugins/wm-modularscale/"
msgstr "https://arnoldwender.com/wordpress-plugins/wm-modularscale/"

#. Description of the plugin
#: wm-modularscale.php
msgid ""
"Generates harmonious, responsive typography ratios and modular scales with a "
"visual live preview sandbox for non-technical users."
msgstr ""
"Ustvarja harmonična, odzivna tipografska razmerja in modularne lestvice z "
"interaktivnim predogledom v živo."

#. Author of the plugin
#: wm-modularscale.php
msgid "Arnold Wender"
msgstr "Arnold Wender"

