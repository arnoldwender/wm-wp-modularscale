msgctxt "block title"
msgid "Fluid Container (@container)"
msgstr "Conteneur fluide (@container)"

#: src/Gutenberg/Blocks/fluid-container/block.json
msgctxt "block description"
msgid ""
"Container for inner blocks that sets container-type (default inline-size) "
"and container-name (default wm-typographic-context) for container queries."
msgstr ""
"Conteneur pour blocs internes définissant container-type (inline-size par "
"défaut) et container-name (wm-typographic-context)."

