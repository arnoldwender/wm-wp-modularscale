msgid "WM Modular Scale"
msgstr "WM Modular Scale"

#. Plugin URI of the plugin
#: wm-modularscale.php
msgid "https://arnoldwender.com/wordpress-plugins/wm-modularscale/"
msgstr "https://arnoldwender.com/wordpress-plugins/wm-modularscale/"

#. Description of the plugin
#: wm-modularscale.php
msgid ""
"Generates harmonious, responsive typography ratios and modular scales with a "
"visual live preview sandbox for non-technical users."
msgstr ""
"Generuje harmonické, responzívne typografické pomery a modulárne stupnice so "
"živým interaktívnym náhľadom."

#. Author of the plugin
#: wm-modularscale.php
msgid "Arnold Wender"
msgstr "Arnold Wender"

