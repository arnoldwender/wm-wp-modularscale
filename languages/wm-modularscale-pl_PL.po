msgstr ""
"Płynne rozmiary pisma między telefonem a komputerem, wyliczane z rozmiaru "
"bazowego i interwału muzycznego."

#: src/Integration/Ecosystem_Bridge.php:221
msgid "GenerateBlocks Fluid Scale Section"
msgstr "Sekcja płynnej skali GenerateBlocks"

#: src/Integration/Ecosystem_Bridge.php:222
msgid ""
"Two-layer GenerateBlocks section (gbp-section + gbp-section__inner) "
"consuming --ms-* and --wm-step-* fluid tokens."
msgstr ""
"Dwuwarstwowa sekcja GenerateBlocks (gbp-section + gbp-section__inner) "
"korzystająca z tokenów --ms-* i --wm-step-*."

#: src/Integration/Ecosystem_Bridge.php:229
