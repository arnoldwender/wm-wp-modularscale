# The workspace's global ignore rule `/Assets/` matches this plugin's root assets/ on a
# case-insensitive filesystem and kept the family sheets and the README banner out of the repo
# (measured 2026-09-14: `git ls-files assets` empty). Same negation as wm-suite-hub.
!assets/
!assets/**

# Ignore node modules and dependencies
node_modules/
npm-debug.log
yarn-error.log

# Ignore WordPress core files
wp-config.php
wp-content/uploads/
wp-content/upgrade/
wp-content/backup-db/

# Ignore build files
*.log
.DS_Store
Thumbs.db

# Ignore editor config files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Claude Code
.claude/*.backup

# Generated documentation
RECOMMENDATIONS.md
RECOMMENDATIONS.md.backup

# Environment variables
.env
.env.local
.env.*.local
.env.production
.env.development

# Docker files
Dockerfile
docker-compose.yml
.dockerignore
.env.*

# Build output
dist/

# Certificates and keys
*.pem
*.key

# AI/internal docs — NEVER commit
agents.md
docs/superpowers/
docs/development/
