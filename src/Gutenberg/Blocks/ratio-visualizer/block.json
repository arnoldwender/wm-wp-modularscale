{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "wm-scale/ratio-visualizer",
  "version": "1.2.0",
  "title": "Ratio Visualizer (SVG Curve)",
  "category": "wm-scale",
  "icon": "chart-line",
  "description": "Shows the nine scale steps with their minimum and maximum size in px, calculated from the stored base sizes and ratio.",
  "keywords": ["visualizer", "ratio", "svg", "curve", "scale", "preview"],
  "textdomain": "wm-modularscale",
  "attributes": {
    "showSteps": {
      "type": "boolean",
      "default": true
    },
    "showMath": {
      "type": "boolean",
      "default": true
    },
    "theme": {
      "type": "string",
      "default": "dark"
    }
  },
  "supports": {
    "align": ["wide", "full"],
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "render": "file:./render.php"
}
