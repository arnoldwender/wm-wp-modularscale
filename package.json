{
  "name": "wm-modularscale",
  "version": "1.2.1",
  "type": "module",
  "description": "WordPress plugin: modular type scale, fluid clamp() tokens and typography bridges. npm is used for the vitest suite only.",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.astro,.vue --max-warnings 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arnoldwender/wm-wp-modularscale.git"
  },
  "keywords": [
    "wordpress",
    "plugin",
    "modular-scale",
    "typography"
  ],
  "author": "Arnold Wender <arnold@wendermedia.com>",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^16.4.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^5.0.1"
  }
}
